{
  "world": {
    "files": {
      "project/README.md": "# App\n",
      "project/app.log": "log\n",
      "project/keep.log": "keep\n",
      "project/.env": "SECRET=1\n",
      "project/dist/app.js": "built\n",
      "project/dist/app.css": "built\n",
      "project/src/main.js": "main\n",
      "project/src/debug.log": "debug\n",
      "project/src/build/out.js": "out\n",
      "project/build/report.txt": "report\n",
      "project/docs/notes.tmp": "tmp\n",
      "project/docs/deep/more.tmp": "tmp\n",
      "project/docs/guide.md": "guide\n",
      "project/#hash.txt": "hash\n",
      "project/!bang.txt": "bang\n",
      "project/vendor/lib/x.js": "x\n",
      "project/vendor/lib/keep.js": "k\n"
    },
    "cwd": "project"
  },
  "steps": [
    "git init -q",
    "git add .env README.md",
    "git commit -q -m \"First\"",
    "echo '*.log' > .gitignore",
    "echo '!keep.log' >> .gitignore",
    "echo 'dist/' >> .gitignore",
    "echo '/build' >> .gitignore",
    "echo 'docs/**/*.tmp' >> .gitignore",
    "echo '# a comment' >> .gitignore",
    "echo '\\#hash.txt' >> .gitignore",
    "echo '\\!bang.txt' >> .gitignore",
    "echo '.env' >> .gitignore",
    "echo 'vendor/' >> .gitignore",
    "echo '!vendor/lib/keep.js' >> .gitignore",
    "cat .gitignore",
    "git status --short",
    "git status --short --ignored",
    "git status --ignored",
    "git add .",
    "git status --short",
    "git add app.log",
    "git add src/debug.log src/main.js",
    "git status --short",
    "git add -f app.log",
    "git status --short --ignored",
    "echo '*.js' > src/.gitignore",
    "echo '!main.js' >> src/.gitignore",
    "git status --short --ignored",
    "git add dist",
    "git add -f dist",
    "git status --short",
    "git commit -q -m \"Ignore rules\"",
    "git status --short --ignored",
    "git status"
  ]
}
