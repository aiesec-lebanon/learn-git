{
  "world": {
    "files": {
      "project/a.txt": "a\n",
      "project/b.txt": "b\n",
      "project/src/c.txt": "c\n"
    },
    "cwd": "project"
  },
  "steps": [
    "git init -q",
    "git add a.txt",
    "git restore --staged a.txt",
    "git restore a.txt",
    "git add .",
    "git commit -q -m \"First\"",
    "echo more >> a.txt",
    "git add a.txt",
    "echo again >> a.txt",
    "git restore a.txt",
    "cat a.txt",
    "git restore --staged a.txt",
    "git status --short",
    "git restore a.txt",
    "git status --short",
    "echo x >> b.txt",
    "echo y >> src/c.txt",
    "git add .",
    "echo z >> b.txt",
    "git restore --staged --worktree b.txt",
    "git status --short",
    "git restore -S -W src",
    "git status --short",
    "echo new > n.txt",
    "git add n.txt",
    "git restore --staged n.txt",
    "git status --short",
    "git restore n.txt",
    "git restore",
    "git restore --staged nope.txt",
    "echo 2 >> a.txt",
    "git add a.txt",
    "git commit -q -m \"Second\"",
    "git restore --source=HEAD~1 a.txt",
    "git status --short",
    "git restore --source HEAD a.txt",
    "git restore -s HEAD~1 --staged a.txt",
    "git status --short",
    "git restore -s HEAD --staged --worktree .",
    "git status --short",
    "rm b.txt",
    "git restore b.txt",
    "cat b.txt",
    "cd src",
    "echo q >> c.txt",
    "git restore c.txt",
    "git restore ../a.txt",
    "cd ..",
    "git restore --source=nope a.txt",
    "git restore --worktree --staged"
  ]
}
