    "git commit -q -m \"Topic\"",
    "git switch -q -c side main",
    "echo side > both.txt",
    "git add .",
    "git commit -q -m \"Side\"",
    "git switch -q main",
    "cat ../v/a-main.txt > a.txt",
    "git commit -q -a -m \"Main\"",
    "git merge -q topic",
    "git config merge.conflictStyle diff3",
    "git switch -q side",
    "git merge -m \"Take topic\" topic"
