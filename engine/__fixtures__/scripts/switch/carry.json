{
  "world": {
    "files": {
      "project/a.txt": "a\n",
      "project/b.txt": "b\n",
      "project/sub/d.txt": "d\n",
      "project/.gitignore": "*.log\n"
    },
    "cwd": "project"
  },
  "steps": [
    "git init -q",
    "git add .",
    "git commit -q -m \"First\"",
    "git switch -q -c topic",
    "echo t >> b.txt",
    "echo c > c.txt",
    "echo l > keep.log",
    "git add -f c.txt keep.log",
    "git rm -q -r sub",
    "git commit -q -a -m \"Topic work\"",
    "git switch main",
    "echo m >> a.txt",
    "git switch topic",
    "git switch main",
    "echo x >> b.txt",
    "git switch topic",
    "git restore b.txt",
    "echo y >> sub/d.txt",
    "git switch topic",
    "git restore sub/d.txt",
    "echo u > c.txt",
    "git switch topic",
    "rm c.txt",
    "echo ignored > keep.log",
    "git switch topic",
    "git switch main",
    "git add a.txt",
    "echo n > new.txt",
    "git add new.txt",
    "rm b.txt",
    "cd sub",
    "git switch topic",
    "cd ..",
    "git status --short",
    "echo b > b.txt",
    "git add b.txt",
    "git switch main",
    "git status --short",
    "echo z >> b.txt",
    "git add b.txt",
    "git switch topic",
    "git status --short"
  ]
}
